---
interface Props {
  name?: 'arrow' | 'phone' | 'check' | 'location';
}
const { name = 'arrow' } = Astro.props;
const paths = {
  arrow: 'M5 12h14m-6-6 6 6-6 6',
  phone: 'M6 3H3v3c0 8.3 6.7 15 15 15h3v-5l-5-2-2 3a12 12 0 0 1-7-7l3-2-2-5H6Z',
  check: 'm5 12 4 4L19 6',
