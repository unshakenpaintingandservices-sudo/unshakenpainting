---
import '@fontsource-variable/manrope';
import '@fontsource-variable/source-serif-4';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { business } from '../data/business';
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, business.url).href;
const launchReady = import.meta.env.PUBLIC_SITE_LAUNCH_READY === 'true';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'HousePainter',
  '@id': `${business.url}/#business`,
  name: business.name,
  url: business.url,
  telephone: business.phone.e164,
  description: `Residential, commercial, and new construction painting based in ${business.homeBase.city}, ${business.homeBase.region}.`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: business.homeBase.city,
    addressRegion: business.homeBase.regionCode,
    addressCountry: business.homeBase.country,
  },
  areaServed: [
    business.homeBase.city,
    'North metro Minnesota',
    'East-central Minnesota',
    ...business.serviceArea.cities,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#193953" />
    <meta
      name="robots"
      content={launchReady ? 'index, follow' : 'noindex, nofollow'}
    />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}
    ></script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
