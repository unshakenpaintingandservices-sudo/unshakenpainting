# Public build-time settings. Keep untrusted previews non-indexable and non-sending.
# Known Vercel production targets use the real form regardless of PUBLIC_INQUIRY_MODE.
# Else exact live is an explicit testing/fallback opt-in; server sending stays separate.
PUBLIC_SITE_LAUNCH_READY=false
PUBLIC_INQUIRY_MODE=preview
PUBLIC_INQUIRY_ENDPOINT=/api/contact/

# Server-only runtime configuration; fill in ignored .env.local / Vercel settings.
# Never prefix these names with PUBLIC_. Never commit real credentials.
RESEND_API_KEY=
# Bare address on your verified sending domain, e.g. website@example.com.
# The server adds the fixed display name "Unshaken Painting".
CONTACT_FROM_EMAIL=
# Grant's separately confirmed working inbox, e.g. owner@example.net.
CONTACT_TO_EMAIL=
# Enable only in a configured local environment, trusted preview, or production.
CONTACT_DELIVERY_ENABLED=false
